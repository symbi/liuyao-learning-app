# ---------------------------------------------------------------------------
# liuyao-kb local configuration (TEMPLATE — copy to .env and fill in)
#
#   cp .env.example .env
#
# The real env file is gitignored. M0 keeps it outside the repository at
# ~/.config/liuyao-kb/m0.env. NEVER commit real values, and never paste
# credentials into a chat window, an issue, a PR, or any document.
# ---------------------------------------------------------------------------

# --- Neo4j AuraDB Free ------------------------------------------------------
# Copy these from the Aura Console: instance details -> Connectivity, or the
# credentials file downloaded when the instance was created.
#
# NEO4J_URI is the standard Aura connection URI, e.g. neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=
# The instance user name. AuraDB names it after the instance, and it is NOT
# always "neo4j" — read it from the credentials file.
NEO4J_USERNAME=
# The instance password. Never committed, never logged.
NEO4J_PASSWORD=
# The user database name. AuraDB names it after the instance, and it is NOT
# always "neo4j" — read it from the credentials file.
NEO4J_DATABASE=

# --- Google Gemini ----------------------------------------------------------
# From https://aistudio.google.com/apikey
# Free-tier content may be used to improve Google products; the user must
# accept the current terms before any real course content is sent.
GEMINI_API_KEY=

# --- Model selection --------------------------------------------------------
# Model ids live in configuration, never hardcoded in business logic.
# Keep the embedding model and its dimension count together: vectors from
# different models are not comparable and must never share an index.
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536

# --- Runtime ----------------------------------------------------------------
# Optional: override the local directory holding .env and local state.
# Default: ~/.config/liuyao-kb
LIUYAO_KB_CONFIG_DIR=
# Log level: DEBUG, INFO, WARNING, ERROR
LIUYAO_KB_LOG_LEVEL=INFO
